// Comic Page Builder: import a page.svg into Photoshop, or update a PSD it made.
//
// Run it from File > Scripts > Browse… and pick this file (Photoshop 2023 or
// newer; tested on 27.4). It asks for a page.svg made by the hub.
//
// * If the active document was made by this script for the same page, it is
//   UPDATED: frames move and resize to the new layout, new panels get new
//   frames, and frames whose panel left the layout are hidden (never deleted).
//   Only the hub's own layers change (Border, Mask, guides). Your art layers
//   are never touched, and one Ctrl+Z undoes the whole update.
// * Otherwise it builds a NEW document:
//
//   Comic Frames          group
//     Frame N             group per panel, in reading order
//       Border N          shape layer: editable stroke, no fill
//       Ink / Color / Sketch   pixel layers, clipped to the mask below
//       Mask N            shape layer: white panel shape (clipping base)
//   Background            white paper
//   + guides at the trim and safe area (guides never print)
//
// The hub's layers carry a small tag in their XMP metadata (cpb:id), so they
// are found by that tag, not by name: renaming or regrouping them by hand
// doesn't break updates.

const { app, core, action, constants } = require("photoshop");
const { localFileSystem } = require("uxp").storage;

// ---------- reading page.svg (only the hub's own attributes) ----------
function attrs(tag) {
  const out = {};
  const re = /([\w:.-]+)="([^"]*)"/g;
  let m;
  while ((m = re.exec(tag))) out[m[1]] = m[2];
  return out;
}

function readPage(text) {
  const rootTag = text.match(/<svg\b[^>]*>/);
  if (!rootTag) throw new Error("This file isn't an SVG.");
  const root = attrs(rootTag[0]);
  if (root["cpb:format"] === "cpb-borders") throw new Error("This is the borders-only file for Clip Studio Paint. Pick the page.svg instead.");
  if (root["cpb:format"] !== "cpb-page") throw new Error("This SVG wasn't made by Comic Page Builder.");
  if (Number(root["cpb:version"] || 1) > 1) throw new Error("This page was saved by a newer Comic Page Builder. Update the script.");
  const num = (k) => {
    const v = parseFloat(root["cpb:" + k]);
    if (isNaN(v)) throw new Error("The page is missing its cpb:" + k + " value.");
    return v;
  };
  const page = {
    number: num("page"), trimW: num("trim-w"), trimH: num("trim-h"),
    bleed: num("bleed"), safe: num("safe"), dpi: num("dpi"), panels: [],
  };
  page.canvasW = page.trimW + 2 * page.bleed;
  page.canvasH = page.trimH + 2 * page.bleed;

  const groupTag = text.match(/<g\b[^>]*id="cpb-panels"[^>]*>/);
  page.radius = groupTag ? parseFloat(attrs(groupTag[0])["cpb:radius"] || "0") : 0;

  const re = /<path\b[^>]*id="cpb-panel-\d+"[^>]*>/g;
  let m;
  while ((m = re.exec(text))) {
    const a = attrs(m[0]);
    if (!a["cpb:rect"]) throw new Error("Panel " + a.id + " has no cpb:rect. Rebuild the page with a newer hub.");
    const [x, y, w, h] = a["cpb:rect"].trim().split(/\s+/).map(Number);
    page.panels.push({
      index: Number(a["cpb:index"]), x, y, w, h,
      // Hand-cut panels are polygons: take the outline the hub drew (rounded
      // corners included) instead of the bounding box in cpb:rect.
      d: a["cpb:points"] ? a.d : null,
      outline: a["cpb:points"] ? parsePath(a.d) : null,
      inset: a["cpb:inset"] ? Number(a["cpb:inset"]) : 0,
      stroke: a.stroke || "#1b1b1b",
      strokeWidth: parseFloat(a["stroke-width"] || "0.6"),
      fill: a.fill && a.fill !== "none" ? a.fill : null,
    });
  }
  // Drawn pages (D7): the hub's image under everything, placed at its rect.
  const imgTag = text.match(/<image\b[^>]*id="cpb-art-image"[^>]*>/);
  if (imgTag) {
    const a = attrs(imgTag[0]);
    page.art = { href: unescapeXml(a["xlink:href"] || a.href || ""), x: parseFloat(a.x), y: parseFloat(a.y),
      w: parseFloat(a.width), h: parseFloat(a.height), key: fingerprint(imgTag[0]) };
  } else page.art = null;
  if (!page.panels.length && !page.art) throw new Error("The page has no panels.");
  page.panels.sort((p, q) => p.index - q.index);

  page.balloons = readBalloons(text);

  // The paper-coloured band around each inset, so what's behind stops short of it.
  page.gaps = [];
  const gapRe = /<path\b[^>]*id="cpb-inset-gap-\d+"[^>]*>/g;
  while ((m = gapRe.exec(text))) {
    const a = attrs(m[0]);
    page.gaps.push({ n: Number(a.id.split("-").pop()), d: a.d, outline: parsePath(a.d),
      color: a.fill || "#ffffff", width: parseFloat(a["stroke-width"] || "0") });
  }
  return page;
}

const unescapeXml = (s) => s.replace(/&#10;/g, "\n").replace(/&quot;/g, '"').replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&amp;/g, "&");

// A short fingerprint of some text (FNV-1a), to notice changes without
// storing the whole thing. Same as in the Illustrator script.
function fingerprint(str) {
  let h = 0x811c9dc5;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = (h + (h << 1) + (h << 4) + (h << 7) + (h << 8) + (h << 24)) >>> 0;
  }
  return h.toString(16);
}

// The Letters layer: one group per balloon, holding its outline and its text
// already broken into lines (tspans with the first baseline's position).
// Balloon parameters stay the hub's business; this only needs what to draw.
function readBalloons(text) {
  const out = [];
  const re = /<g\b[^>]*id="cpb-balloon-(\d+)"[^>]*>[\s\S]*?<\/g>/g;
  let m;
  while ((m = re.exec(text))) {
    const g = attrs(m[0].match(/<g\b[^>]*>/)[0]);
    let font = {};
    try { font = JSON.parse(unescapeXml(g["cpb:font"] || "{}")); } catch (e) { /* the defaults below will do */ }
    const pathTag = m[0].match(/<path\b[^>]*>/);
    const textEl = m[0].match(/<text\b[^>]*>([\s\S]*?)<\/text>/);
    if (!pathTag) continue;
    const pa = attrs(pathTag[0]);
    const spans = [];
    if (textEl) {
      const sre = /<tspan\b([^>]*)>([\s\S]*?)<\/tspan>/g;
      let s;
      while ((s = sre.exec(textEl[1]))) {
        const sa = attrs(s[1]);
        spans.push({ x: parseFloat(sa.x), y: parseFloat(sa.y), text: unescapeXml(s[2]) });
      }
    }
    const size = Number(font.size_pt) || 8;
    out.push({
      number: Number(m[1]),
      key: fingerprint(m[0]),
      outline: parsePath(pa.d),
      fill: pa.fill && pa.fill !== "none" ? pa.fill : null,
      stroke: pa.stroke && pa.stroke !== "none" ? pa.stroke : null,
      strokeWidth: parseFloat(pa["stroke-width"] || "0.35"),
      dash: pa["stroke-dasharray"] ? pa["stroke-dasharray"].split(/[\s,]+/).map(Number) : null,
      lines: spans.map((sp) => sp.text),
      x: spans.length ? spans[0].x : 0, y: spans.length ? spans[0].y : 0,
      size,
      // Baseline to baseline as the hub laid it out, in points.
      leading: spans.length > 1 ? (spans[1].y - spans[0].y) * 72 / 25.4 : size * (Number(font.leading) || 1.2),
      psName: font.ps_name || "",
      color: textEl ? (attrs(textEl[0].match(/<text\b[^>]*>/)[0]).fill || "#1b1b1b") : "#1b1b1b",
    });
  }
  return out;
}

// An SVG path made of M/L/H/V/C/Z (absolute), the only commands the hub writes,
// as a list of subpaths (a thought balloon's trail of bubbles has several),
// each a list of anchors in mm. A curve's first handle belongs to the anchor
// before it ("forward"), its second to the anchor it ends on ("backward"),
// which is how Photoshop stores path points.
function parsePath(d) {
  // Any letter is a token, so a command we don't know stops the import
  // instead of being skipped and leaving a wrong shape.
  const tokens = d.match(/[a-z]|-?\d*\.?\d+(?:e[-+]?\d+)?/gi) || [];
  const subpaths = [];
  let pts = [];
  let i = 0, cmd = null;
  const next = () => Number(tokens[i++]);
  const xy = () => ({ x: next(), y: next() });
  while (i < tokens.length) {
    if (/[a-z]/i.test(tokens[i])) cmd = tokens[i++];
    if (cmd === "Z") { closeSubpath(pts); if (pts.length) subpaths.push(pts); pts = []; continue; }
    const prev = pts[pts.length - 1];
    if (cmd === "M" && pts.length) { closeSubpath(pts); subpaths.push(pts); pts = []; }
    if (cmd === "M" || cmd === "L") pts.push(xy());
    else if (cmd === "H") pts.push({ x: next(), y: prev.y });
    else if (cmd === "V") pts.push({ x: prev.x, y: next() });
    else if (cmd === "C") {
      const c1 = xy(), c2 = xy(), p = xy();
      prev.forward = c1;
      pts.push({ ...p, backward: c2 });
    } else throw new Error("Unexpected path command " + cmd + " in a panel outline.");
  }
  closeSubpath(pts);
  if (pts.length) subpaths.push(pts);
  return subpaths;
}

// A rounded outline ends on its starting point: fold that duplicate back in.
function closeSubpath(pts) {
  const first = pts[0], last = pts[pts.length - 1];
  if (pts.length > 1 && Math.abs(first.x - last.x) < 1e-6 && Math.abs(first.y - last.y) < 1e-6) {
    if (last.backward) first.backward = last.backward;
    pts.pop();
  }
}

// ---------- helpers ----------
const px = (mm, dpi) => (mm * dpi) / 25.4;
const unit = (v) => ({ _unit: "pixelsUnit", _value: v });
const { PLACEBEFORE, PLACEAFTER, PLACEINSIDE } = constants.ElementPlacement; // above, below, inside

function rgb(hex) {
  const n = parseInt(hex.replace("#", ""), 16);
  return { _obj: "RGBColor", red: (n >> 16) & 255, grain: (n >> 8) & 255, blue: n & 255 };
}

function rectShape(r, radius) {
  const shape = {
    _obj: "rectangle", unitValueQuadVersion: 1,
    top: unit(r.top), left: unit(r.left), bottom: unit(r.bottom), right: unit(r.right),
  };
  if (radius > 0) {
    shape.topRight = unit(radius); shape.topLeft = unit(radius);
    shape.bottomLeft = unit(radius); shape.bottomRight = unit(radius);
  }
  return shape;
}

// Where a frame goes, in pixels: a rectangle, plus the outline for polygons.
const frameRect = (p, d) => ({ left: px(p.x, d), top: px(p.y, d), right: px(p.x + p.w, d), bottom: px(p.y + p.h, d),
  outline: p.outline ? scaleOutline(p.outline, d) : null });
const scaleOutline = (subpaths, d) => subpaths.map((sp) => sp.map((q) => scalePoint(q, d)));
const scalePoint = (q, d) => {
  const s = (v) => v && { x: px(v.x, d), y: px(v.y, d) };
  return { x: px(q.x, d), y: px(q.y, d), forward: s(q.forward), backward: s(q.backward) };
};

// A closed path for a shape layer. Corners are rounded already (the hub draws
// them as curves), so there's no radius here.
function pathShape(subpaths) {
  const paint = (v) => ({ _obj: "paint", horizontal: unit(v.x), vertical: unit(v.y) });
  return {
    _obj: "pathClass",
    pathComponents: [{
      _obj: "pathComponent",
      shapeOperation: { _enum: "shapeOperation", _value: "add" },
      subpathListKey: subpaths.map((points) => ({
        _obj: "subpathsList", closedSubpath: true,
        points: points.map((q) => {
          const pt = { _obj: "pathPoint", anchor: paint(q) };
          if (q.forward) pt.forward = paint(q.forward);
          if (q.backward) pt.backward = paint(q.backward);
          return pt;
        }),
      })),
    }],
  };
}
const maskStyle = (page, p) => ({ fill: p.fill || "#ffffff", stroke: null, radius: px(page.radius, page.dpi) });
const borderStyle = (page, p) => ({ fill: null, stroke: p.stroke, strokeWidth: px(p.strokeWidth, page.dpi), radius: px(page.radius, page.dpi) });
// Everything that decides how a frame looks. Same key = nothing to redraw,
// so running the script twice in a row changes nothing.
// The outline is only added for polygons, so frames imported before polygons
// existed keep their key and aren't redrawn for nothing.
const frameKey = (page, p) => [p.x, p.y, p.w, p.h, p.stroke, p.strokeWidth, p.fill || "none", page.radius]
  .concat(p.d ? [p.d] : []).join(" ");

// One shape layer (rectangle or polygon), made above the selected layer. `fill` and
// `stroke` are hex colours or null.
// `dash` is a list of dash and gap lengths in px; `join` is "miter" or "round".
async function makeShape(name, r, { fill, stroke, strokeWidth, radius, dash, join }) {
  const strokeStyle = {
    _obj: "strokeStyle", strokeStyleVersion: 2,
    strokeEnabled: !!stroke, fillEnabled: !!fill,
  };
  if (stroke) {
    Object.assign(strokeStyle, {
      strokeStyleLineWidth: unit(strokeWidth),
      strokeStyleLineAlignment: { _enum: "strokeStyleLineAlignment", _value: "strokeStyleAlignCenter" },
      strokeStyleLineCapType: { _enum: "strokeStyleLineCapType", _value: "strokeStyleButtCap" },
      strokeStyleLineJoinType: { _enum: "strokeStyleLineJoinType", _value: join === "round" ? "strokeStyleRoundJoin" : "strokeStyleMiterJoin" },
      strokeStyleContent: { _obj: "solidColorLayer", color: rgb(stroke) },
      strokeStyleOpacity: { _unit: "percentUnit", _value: 100 },
    });
    // Photoshop measures dashes in stroke widths.
    if (dash && dash.length) strokeStyle.strokeStyleLineDashSet = dash.map((v) => ({ _unit: "noneUnit", _value: v / strokeWidth }));
  }
  await action.batchPlay([{
    _obj: "make",
    _target: [{ _ref: "contentLayer" }],
    using: {
      _obj: "contentLayer",
      type: { _obj: "solidColorLayer", color: rgb(fill || "#ffffff") },
      shape: r.outline ? pathShape(r.outline) : rectShape(r, radius),
      strokeStyle,
    },
  }], {});
  const layer = app.activeDocument.activeLayers[0];
  layer.name = name;
  return layer;
}

// Never leave an art layer selected before making a shape: if the selected
// layer is an EMPTY pixel layer, Photoshop swaps it for the new shape layer
// and the art layer is gone (found in the M2 test).
async function selectLayer(layer) {
  await action.batchPlay([{ _obj: "select", _target: [{ _ref: "layer", _id: layer.id }], makeVisible: false }], {});
}

// Setting isClippingMask = false on a layer that isn't clipped throws
// ("Release Clipping Mask is not available"), so ask first.
function unclip(layer) {
  if (layer.isClippingMask) layer.isClippingMask = false;
}

// ---------- tags: how the script recognises its own layers ----------
const CPB_NS = "https://github.com/Scorpiidev/comic-page-builder/ns/1/";
const esc = (s) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
const unesc = (s) => s.replace(/&quot;/g, '"').replace(/&lt;/g, "<").replace(/&amp;/g, "&");

async function setTag(layer, tag) {
  const fields = Object.entries(tag).map(([k, v]) => ` cpb:${k}="${esc(v)}"`).join("");
  const xmp = '<x:xmpmeta xmlns:x="adobe:ns:meta/"><rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">' +
    `<rdf:Description rdf:about="" xmlns:cpb="${CPB_NS}"${fields}/></rdf:RDF></x:xmpmeta>`;
  await action.batchPlay([{
    _obj: "set",
    _target: [{ _ref: "property", _property: "metadata" }, { _ref: "layer", _id: layer.id }],
    to: { _obj: "metadata", layerXMP: xmp },
  }], {});
}

function parseTag(xmp) {
  if (!xmp || xmp.indexOf(CPB_NS) < 0) return null;
  const tag = {};
  // Attributes as we write them, and the element form in case Photoshop rewrites the packet.
  for (const re of [/cpb:([\w-]+)="([^"]*)"/g, /<cpb:([\w-]+)>([^<]*)<\/cpb:\1>/g]) {
    let m;
    while ((m = re.exec(xmp))) tag[m[1]] = unesc(m[2]);
  }
  return tag.id ? tag : null;
}

function flatten(layers, out = []) {
  for (const layer of layers) {
    out.push(layer);
    if (layer.layers) flatten(layer.layers, out);
  }
  return out;
}

// Map of tag id -> { layer, tag }. Layers are listed top to bottom, and a
// duplicated layer copies its tag, so the topmost copy wins.
async function findTagged(doc) {
  const all = flatten(doc.layers);
  const found = new Map();
  if (!all.length) return found;
  const results = await action.batchPlay(all.map((layer) => ({
    _obj: "get", _target: [{ _ref: "property", _property: "metadata" }, { _ref: "layer", _id: layer.id }],
  })), {});
  all.forEach((layer, i) => {
    const r = results[i];
    const tag = parseTag(r && r.metadata && r.metadata.layerXMP);
    if (tag && !found.has(tag.id)) found.set(tag.id, { layer, tag });
  });
  return found;
}

// ---------- frames and guides ----------
// Builds one frame group above the selected layer and returns it.
async function buildFrame(doc, page, p) {
  const r = frameRect(p, page.dpi);
  const mask = await makeShape(`Mask ${p.index}`, r, maskStyle(page, p));
  // Make the Border while the Mask is selected (see selectLayer).
  const border = await makeShape(`Border ${p.index}`, r, borderStyle(page, p));
  const sketch = await doc.createLayer({ name: "Sketch" });
  const color = await doc.createLayer({ name: "Color" });
  const ink = await doc.createLayer({ name: "Ink" });
  // The new art layers land above the Border (selecting the Mask first
  // didn't change that in the M2 test), so lift the Border back above Ink.
  // Clip only afterwards, so the art clips to the Mask, not to the Border.
  border.move(ink, PLACEBEFORE);
  for (const l of [sketch, color, ink]) l.isClippingMask = true;
  const group = await doc.createLayerGroup({ name: `Frame ${p.index}`, fromLayers: [border, ink, color, sketch, mask] });
  await setTag(mask, { id: `cpb-mask-${p.index}` });
  await setTag(border, { id: `cpb-border-${p.index}` });
  await setTag(group, { id: `cpb-frame-${p.index}`, key: frameKey(page, p) });
  return group;
}

// Redraw a hub shape layer in place: the new one is made right above the old
// one, then the old one is deleted. Photoshop can unclip the art while that
// happens (unclipping a layer also unclips the layers above it), so note which
// neighbours were clipped first and clip them again afterwards.
async function replaceShape(old, r, style, id) {
  const siblings = old.parent ? old.parent.layers : app.activeDocument.layers;
  const clipped = siblings.filter((l) => l.id !== old.id && l.isClippingMask);
  await selectLayer(old);
  const fresh = await makeShape(old.name, r, style); // keep a name you gave it
  unclip(fresh);
  fresh.visible = old.visible;
  await setTag(fresh, { id });
  old.delete();
  // Bottom to top, so each layer finds its clipping base already in place.
  for (const l of clipped.reverse()) if (!l.isClippingMask) l.isClippingMask = true;
  return fresh;
}

// Guides at the trim and safe area, as text ("v70.866 h70.866 …"). The text is
// stored in the Comic Frames tag, so an update can remove exactly these guides
// and leave the ones you added alone.
function guideText(page) {
  const d = page.dpi, out = [];
  const trim = [page.bleed, page.canvasW - page.bleed, page.bleed, page.canvasH - page.bleed];
  const safe = [page.bleed + page.safe, page.canvasW - page.bleed - page.safe, page.bleed + page.safe, page.canvasH - page.bleed - page.safe];
  for (const [x1, x2, y1, y2] of [trim, safe]) {
    for (const x of [x1, x2]) out.push("v" + px(x, d).toFixed(3));
    for (const y of [y1, y2]) out.push("h" + px(y, d).toFixed(3));
  }
  return out.join(" ");
}

const parseGuides = (text) => (text || "").split(/\s+/).filter(Boolean).map((g) => ({ v: g[0] === "v", at: parseFloat(g.slice(1)) }));

function addGuides(doc, text) {
  for (const g of parseGuides(text)) doc.guides.add(g.v ? constants.Direction.VERTICAL : constants.Direction.HORIZONTAL, g.at);
}

function removeGuides(doc, text) {
  const ours = parseGuides(text);
  for (let i = doc.guides.length - 1; i >= 0; i--) {
    const g = doc.guides[i];
    const v = g.direction === constants.Direction.VERTICAL;
    if (ours.some((o) => o.v === v && Math.abs(o.at - g.coordinate) < 0.5)) g.delete();
  }
}

// ---------- insets ----------
// Each inset is a group above the ordinary frames: its frames, and under them
// an "Inset gap" shape, a paper-coloured band that hides what's behind.
const insetNumbers = (page) => [...new Set(page.panels.filter((p) => p.inset).map((p) => p.inset))].sort((a, b) => a - b);
const gapRect = (page, g) => ({ outline: scaleOutline(g.outline, page.dpi) });
const gapStyle = (page, g) => ({ fill: g.color, stroke: g.color, strokeWidth: px(g.width, page.dpi), radius: 0 });
const gapKey = (g) => [g.d, g.color, g.width].join(" ");

async function makeGap(page, g) {
  const layer = await makeShape("Inset gap", gapRect(page, g), gapStyle(page, g));
  await setTag(layer, { id: `cpb-inset-gap-${g.n}`, key: gapKey(g) });
  return layer;
}

async function buildInset(doc, page, n) {
  const layers = [];
  const gap = page.gaps.find((g) => g.n === n);
  if (gap) layers.push(await makeGap(page, gap));
  for (const p of page.panels.filter((q) => q.inset === n).reverse()) layers.push(await buildFrame(doc, page, p));
  const group = await doc.createLayerGroup({ name: `Inset ${n}`, fromLayers: layers });
  await setTag(group, { id: `cpb-inset-${n}` });
  return group;
}

const parentId = (layer) => (layer.parent ? layer.parent.id : null);

// Brings the inset groups in line with the page after an update: makes
// missing groups, redraws or adds gaps, moves frames in or out of their inset
// (a panel's number can change insets when the layout changes), and removes
// the gap of an inset that left. A group is only deleted once it's empty, so
// layers you put in it stay.
async function syncInsets(doc, page, tagged, comicFrames, done) {
  const wanted = insetNumbers(page);
  for (const n of wanted) {
    const box = tagged.get(`cpb-inset-${n}`).layer;
    const g = page.gaps.find((q) => q.n === n);
    const old = tagged.get(`cpb-inset-gap-${n}`);
    if (g && old && old.tag.key !== gapKey(g)) {
      const fresh = await replaceShape(old.layer, gapRect(page, g), gapStyle(page, g), `cpb-inset-gap-${n}`);
      await setTag(fresh, { id: `cpb-inset-gap-${n}`, key: gapKey(g) });
      done.insets.add(n);
    } else if (g && !old) {
      await selectLayer(box);
      const layer = await makeGap(page, g);
      const kids = box.layers || [];
      if (kids.length > 1) layer.move(kids[kids.length - 1], PLACEAFTER); else layer.move(box, PLACEINSIDE);
      unclip(layer);
      done.insets.add(n);
    } else if (!g && old) {
      old.layer.delete(); // "Gap around insets" was turned off
      done.insets.add(n);
    }
  }
  for (const p of page.panels) {
    const frame = tagged.get(`cpb-frame-${p.index}`).layer;
    const box = p.inset ? tagged.get(`cpb-inset-${p.inset}`).layer : comicFrames;
    if (parentId(frame) !== box.id) { await placeFrame(frame, p, page, tagged, comicFrames); done.insets.add(p.inset || "moved"); }
  }
  for (const [id, t] of [...tagged]) {
    const m = id.match(/^cpb-inset-(\d+)$/);
    if (!m || wanted.includes(Number(m[1]))) continue;
    const gap = tagged.get(`cpb-inset-gap-${m[1]}`);
    if (gap) { gap.layer.delete(); tagged.delete(`cpb-inset-gap-${m[1]}`); }
    if (!(t.layer.layers || []).length) { t.layer.delete(); tagged.delete(id); }
  }
}

// An inset that's new on this page: an empty group on top of Comic Frames.
async function addInsetGroups(doc, page, tagged, comicFrames) {
  for (const n of insetNumbers(page)) {
    if (tagged.has(`cpb-inset-${n}`)) continue;
    await selectLayer(comicFrames);
    const group = await doc.createLayerGroup({ name: `Inset ${n}` });
    group.move(comicFrames, PLACEINSIDE);
    await setTag(group, { id: `cpb-inset-${n}` });
    tagged.set(`cpb-inset-${n}`, { layer: group, tag: { id: `cpb-inset-${n}` } });
  }
}

// Puts a frame group in its place: inside its inset group, or among the
// ordinary frames, in reading order between its neighbours.
async function placeFrame(group, p, page, tagged, comicFrames) {
  const box = p.inset ? tagged.get(`cpb-inset-${p.inset}`).layer : comicFrames;
  const frameOf = (q) => tagged.get(`cpb-frame-${q.index}`);
  const here = (q) => q.index !== p.index && q.inset === p.inset && frameOf(q) && parentId(frameOf(q).layer) === box.id;
  const before = page.panels.filter((q) => q.index < p.index && here(q)).pop();
  const after = page.panels.find((q) => q.index > p.index && here(q));
  if (before) group.move(frameOf(before).layer, PLACEAFTER);
  else if (after) group.move(frameOf(after).layer, PLACEBEFORE);
  else if (p.inset) group.move(box, PLACEINSIDE); // top of the inset, above its gap
  else {
    // Below the inset groups, which have to stay on top.
    const kids = (comicFrames.layers || []).filter((l) => l.id !== group.id);
    if (kids.length) group.move(kids[kids.length - 1], PLACEAFTER); else group.move(comicFrames, PLACEINSIDE);
  }
}

// ---------- art (drawn pages) ----------
// The image is placed as an embedded smart object, so the PSD carries it
// (and CSP can read it), scaled and moved onto the rect page.svg gives it.
// Returns the layer, or null with a reason in `problems` if the file is gone.
async function placeArt(doc, page, problems) {
  const path = page.dir + "/" + page.art.href;
  let entry;
  try { entry = await localFileSystem.getEntryWithUrl("file:" + path); }
  catch (e) { problems.push(`Couldn't find the page's art: ${path}`); return null; }
  const token = localFileSystem.createSessionToken(entry);
  await action.batchPlay([{ _obj: "placeEvent", null: { _path: token, _kind: "local" }, linked: false }], {});
  const layer = doc.activeLayers[0];
  const d = page.dpi;
  const want = { left: px(page.art.x, d), top: px(page.art.y, d), w: px(page.art.w, d), h: px(page.art.h, d) };
  let b = layer.bounds;
  await layer.scale((want.w / (b.right - b.left)) * 100, (want.h / (b.bottom - b.top)) * 100);
  b = layer.bounds;
  await layer.translate(want.left - b.left, want.top - b.top);
  layer.name = "Art";
  await setTag(layer, { id: "cpb-art", key: page.art.key });
  return layer;
}

// Update: new art (another file, or moved) goes in above the old, which is
// kept hidden: you may have painted fixes into it.
async function syncArt(doc, page, tagged, done, problems) {
  const old = tagged.get("cpb-art");
  if (!page.art) return;
  if (old && old.tag.key === page.art.key) return;
  if (old) await selectLayer(old.layer);
  else await selectLayer(doc.layers[doc.layers.length - 1]);
  const layer = await placeArt(doc, page, problems);
  if (!layer) return;
  if (old) {
    old.layer.name = "Old art";
    await setTag(old.layer, { id: "" });
    old.layer.visible = false;
  } else {
    // Under everything else, like a new document.
    const bottom = doc.layers[doc.layers.length - 1];
    if (bottom.id !== layer.id && !bottom.isBackgroundLayer) layer.move(bottom, PLACEAFTER);
  }
  done.art = true;
}

// ---------- letters ----------
// A "Letters" group on top of everything: one "Balloon N" group per balloon,
// a text layer over a shape layer. The text is live type in the preset's
// exact face (by PostScript name), centred, with the hub's line breaks.
const balloonStyle = (page, b) => ({
  fill: b.fill, stroke: b.stroke, strokeWidth: px(b.strokeWidth, page.dpi), radius: 0, join: "round",
  dash: b.dash ? b.dash.map((v) => px(v, page.dpi)) : null,
});
const balloonShape = (page, b) => ({ outline: scaleOutline(b.outline, page.dpi) });

// Photoshop's scripting takes type sizes as if the document were 72 dpi, so
// 8 pt at 600 dpi has to be asked for as 8 × 600 / 72. The Character panel
// then shows 8 pt, and that's what prints.
async function makeText(doc, page, b, missing) {
  const k = page.dpi / 72;
  const opts = { contents: b.lines.join("\r"), fontSize: b.size * k,
    position: { x: px(b.x, page.dpi), y: px(b.y, page.dpi) } };
  let t;
  try {
    t = await doc.createTextLayer({ ...opts, fontName: b.psName || undefined });
  } catch (e) {
    t = await doc.createTextLayer(opts);
  }
  const ti = t.textItem;
  if (b.psName && ti.characterStyle.font !== b.psName && !missing.includes(b.psName)) missing.push(b.psName);
  // The anchor is the first baseline; centring keeps it where the hub put it.
  ti.paragraphStyle.justification = constants.Justification.CENTER;
  ti.characterStyle.leading = b.leading * k;
  try {
    const c = new app.SolidColor();
    const n = parseInt(b.color.replace("#", ""), 16);
    c.rgb.red = (n >> 16) & 255; c.rgb.green = (n >> 8) & 255; c.rgb.blue = n & 255;
    ti.characterStyle.color = c;
  } catch (e) { /* the default colour is close enough */ }
  await setTag(t, { id: `cpb-balloon-${b.number}-text`, words: fingerprint(String(ti.contents)) });
  return t;
}

async function makeOutline(page, b) {
  const shape = await makeShape(`Balloon ${b.number}`, balloonShape(page, b), balloonStyle(page, b));
  await setTag(shape, { id: `cpb-balloon-${b.number}-outline` });
  return shape;
}

async function buildBalloon(doc, page, b, missing) {
  const shape = await makeOutline(page, b);
  const text = await makeText(doc, page, b, missing);
  const group = await doc.createLayerGroup({ name: `Balloon ${b.number}`, fromLayers: [text, shape] });
  await setTag(group, { id: `cpb-balloon-${b.number}`, key: b.key });
  return group;
}

// New document: balloons in file order, each above the last, as in page.svg.
async function buildLetters(doc, page, missing) {
  if (!page.balloons.length) return null;
  const groups = [];
  for (const b of page.balloons) groups.push(await buildBalloon(doc, page, b, missing));
  const letters = await doc.createLayerGroup({ name: "Letters", fromLayers: groups });
  await setTag(letters, { id: "cpb-letters" });
  return letters;
}

// Update: redraw balloons whose group changed in page.svg, add new ones, hide
// ones that left (never deleted). Text you edited here is never thrown away:
// if the hub changed that balloon too, your layer is kept, hidden, under the new one.
async function syncLetters(doc, page, tagged, comicFrames, done, missing) {
  let letters = tagged.get("cpb-letters");
  if (!letters && !page.balloons.length) return;
  if (!letters) {
    await selectLayer(comicFrames);
    const group = await doc.createLayerGroup({ name: "Letters" });
    group.move(comicFrames, PLACEBEFORE);
    await setTag(group, { id: "cpb-letters" });
    letters = { layer: group, tag: { id: "cpb-letters" } };
    tagged.set("cpb-letters", letters);
  }
  const wanted = new Set();
  for (const b of page.balloons) {
    const id = `cpb-balloon-${b.number}`;
    wanted.add(id);
    const g = tagged.get(id);
    if (!g) {
      await selectLayer(letters.layer);
      const group = await buildBalloon(doc, page, b, missing);
      group.move(letters.layer, PLACEINSIDE);
      done.balloonsAdded.push(b.number);
      continue;
    }
    const wasHidden = g.tag.hidden === "1";
    if (wasHidden) { g.layer.visible = true; done.balloonsShown.push(b.number); }
    const outline = tagged.get(`${id}-outline`), text = tagged.get(`${id}-text`);
    if (g.tag.key === b.key && outline && text) {
      if (wasHidden) await setTag(g.layer, { id, key: b.key });
      continue;
    }
    if (outline) await replaceShape(outline.layer, balloonShape(page, b), balloonStyle(page, b), `${id}-outline`);
    else await addMissingShape(g.layer, balloonShape(page, b), balloonStyle(page, b), `Balloon ${b.number}`, `${id}-outline`, "bottom");
    if (text) {
      const edited = text.tag.words && fingerprint(String(text.layer.textItem.contents)) !== text.tag.words;
      await selectLayer(text.layer);
      const fresh = await makeText(doc, page, b, missing);
      if (edited) {
        text.layer.name = `Your edit of balloon ${b.number}`;
        await setTag(text.layer, { id: "" }); // yours now, not the hub's
        done.kept.push(b.number);
      } else {
        text.layer.delete();
      }
      fresh.move(g.layer, PLACEINSIDE);
      // Hidden last: setting the tag or moving its neighbour showed it again.
      if (edited) text.layer.visible = false;
    } else {
      await selectLayer(g.layer);
      const fresh = await makeText(doc, page, b, missing);
      fresh.move(g.layer, PLACEINSIDE);
    }
    await setTag(g.layer, { id, key: b.key });
    done.balloonsRedrawn.push(b.number);
  }
  for (const [id, t] of tagged) {
    if (!/^cpb-balloon-\d+$/.test(id) || wanted.has(id) || t.tag.hidden === "1") continue;
    t.layer.visible = false;
    await setTag(t.layer, { ...t.tag, hidden: "1" });
    done.balloonsHidden.push(id.split("-").pop());
  }
}

const fontLine = (missing) => missing.length ? `Not installed, so their balloons use a stand-in: ${missing.join(", ")}.` : "";

// ---------- new document ----------
async function buildDocument(page, fileName) {
  const d = page.dpi;
  const W = Math.round(px(page.canvasW, d)), H = Math.round(px(page.canvasH, d));
  const doc = await app.documents.add({
    name: fileName.replace(/\.svg$/i, ""),
    width: W, height: H, resolution: d,
    mode: constants.NewDocumentMode.RGB,
    fill: constants.DocumentFill.WHITE,
  });
  const guides = guideText(page);
  addGuides(doc, guides);
  const problems = [];
  if (page.art) await placeArt(doc, page, problems);
  const frames = [];
  // Build the last panel first so Frame 1 ends up at the top of the Layers panel.
  for (const p of page.panels.filter((q) => !q.inset).reverse()) frames.push(await buildFrame(doc, page, p));
  // Insets last, so they sit above the panels they overlap (the hub paints them last too).
  for (const n of insetNumbers(page)) frames.push(await buildInset(doc, page, n));
  // Kept even when empty (drawn pages): its tag holds the page number and guides for updates.
  const group = frames.length ? await doc.createLayerGroup({ name: "Comic Frames", fromLayers: frames })
    : await doc.createLayerGroup({ name: "Comic Frames" });
  await setTag(group, { id: "cpb-frames", page: page.number, guides });
  const missing = [];
  const letters = await buildLetters(doc, page, missing);
  // On a drawn page Comic Frames is empty, and Photoshop builds new layers
  // inside a selected empty group, so put Letters back above it.
  if (letters) letters.move(group, PLACEBEFORE);
  const balloons = page.balloons.length ? ` and ${page.balloons.length} balloons` : "";
  const what = page.panels.length ? `${page.panels.length} panels` : "a drawn page";
  const notes = problems.concat(missing.length ? [fontLine(missing)] : []);
  return `Imported ${fileName}: ${what}${balloons} on a ${page.canvasW} × ${page.canvasH} mm ` +
    `canvas (${W} × ${H} px at ${d} dpi).` + (notes.length ? "\n\n" + notes.join("\n") : "");
}

// ---------- update an existing document ----------
// Resizing the canvas would shift or rescale the art, so a page whose size
// changed is refused and left to you. Returns the reason, or null if it fits.
function sizeProblem(doc, page) {
  const d = page.dpi;
  const W = Math.round(px(page.canvasW, d)), H = Math.round(px(page.canvasH, d));
  const w = Math.round(doc.width), h = Math.round(doc.height), dpi = Math.round(doc.resolution);
  if (w === W && h === H && dpi === Math.round(d)) return null;
  return `Nothing changed. ${doc.name} is ${w} × ${h} px at ${dpi} dpi, but page ${page.number} ` +
    `is now ${W} × ${H} px at ${d} dpi.\n\n` +
    "To get it as a new document instead, switch to another document (or close this one) and run the script again.";
}

async function updateDocument(doc, page, tagged, fileName) {
  const d = page.dpi;
  const frames = tagged.get("cpb-frames");
  const done = { redrawn: [], added: [], hidden: [], shown: [], insets: new Set(),
    balloonsRedrawn: [], balloonsAdded: [], balloonsHidden: [], balloonsShown: [], kept: [], art: false };
  const missing = [], problems = [];
  await syncArt(doc, page, tagged, done, problems);
  await addInsetGroups(doc, page, tagged, frames.layer);

  for (const p of page.panels) {
    const frame = tagged.get(`cpb-frame-${p.index}`);
    if (!frame) {
      await addFrame(doc, page, p, tagged, frames.layer);
      done.added.push(p.index);
      continue;
    }
    const key = frameKey(page, p);
    const wasHidden = frame.tag.hidden === "1";
    if (wasHidden) { frame.layer.visible = true; done.shown.push(p.index); }
    const mask = tagged.get(`cpb-mask-${p.index}`), border = tagged.get(`cpb-border-${p.index}`);
    if (frame.tag.key !== key || !mask || !border) {
      const r = frameRect(p, d);
      if (mask) await replaceShape(mask.layer, r, maskStyle(page, p), `cpb-mask-${p.index}`);
      else await addMissingShape(frame.layer, r, maskStyle(page, p), `Mask ${p.index}`, `cpb-mask-${p.index}`, "bottom");
      if (border) await replaceShape(border.layer, r, borderStyle(page, p), `cpb-border-${p.index}`);
      else await addMissingShape(frame.layer, r, borderStyle(page, p), `Border ${p.index}`, `cpb-border-${p.index}`, "top");
      done.redrawn.push(p.index);
    }
    if (frame.tag.key !== key || wasHidden) await setTag(frame.layer, { id: frame.tag.id, key });
  }

  await syncInsets(doc, page, tagged, frames.layer, done);
  await syncLetters(doc, page, tagged, frames.layer, done, missing);

  // Frames whose panel left the layout: hidden, never deleted, so no art is lost.
  const wanted = new Set(page.panels.map((p) => `cpb-frame-${p.index}`));
  for (const [id, t] of tagged) {
    if (!/^cpb-frame-\d+$/.test(id) || wanted.has(id) || t.tag.hidden === "1") continue;
    t.layer.visible = false;
    await setTag(t.layer, { ...t.tag, hidden: "1" });
    done.hidden.push(t.layer.name);
  }

  // Only when the trim or safe area moved: redrawing them every time would
  // make a run with nothing to do still leave a step in the History panel.
  const guides = guideText(page);
  if (guides !== frames.tag.guides) {
    removeGuides(doc, frames.tag.guides);
    addGuides(doc, guides);
    await setTag(frames.layer, { ...frames.tag, guides });
  }

  const lines = [];
  if (done.redrawn.length) lines.push(`Moved or redrawn: frames ${done.redrawn.join(", ")}.`);
  if (done.added.length) lines.push(`New frames: ${done.added.join(", ")}.`);
  if (done.shown.length) lines.push(`Shown again: frames ${done.shown.join(", ")}.`);
  if (done.insets.size) lines.push("Rearranged the inset groups.");
  if (done.balloonsRedrawn.length) lines.push(`Redrawn balloons: ${done.balloonsRedrawn.join(", ")}.`);
  if (done.balloonsAdded.length) lines.push(`New balloons: ${done.balloonsAdded.join(", ")}.`);
  if (done.balloonsShown.length) lines.push(`Balloons shown again: ${done.balloonsShown.join(", ")}.`);
  if (done.balloonsHidden.length) lines.push(`Hidden balloons (gone from the page, kept): ${done.balloonsHidden.join(", ")}.`);
  if (done.kept.length) lines.push(`You'd edited the text of balloon ${done.kept.join(", ")} here and the hub changed it too: ` +
    `your version is kept, hidden, under the new one ("Your edit of balloon …").`);
  if (done.art) lines.push("New art placed; the old art layer is kept, hidden (\"Old art\").");
  if (missing.length) lines.push(fontLine(missing));
  lines.push(...problems);
  if (done.hidden.length) lines.push(`Hidden (their panel left the layout; art kept): ${done.hidden.join(", ")}.`);
  if (!lines.length && guides === frames.tag.guides) return `${doc.name} already matches ${fileName}. Nothing changed.`;
  if (!lines.length) lines.push("Moved the trim and safe guides.");
  return `Updated ${doc.name} from ${fileName}.\n${lines.join("\n")}\n\n` +
    "Art layers weren't touched. Ctrl+Z undoes the whole update.";
}

// A panel with no frame yet: build it, then slot it in (see placeFrame).
async function addFrame(doc, page, p, tagged, comicFrames) {
  await selectLayer(comicFrames);
  const group = await buildFrame(doc, page, p);
  await placeFrame(group, p, page, tagged, comicFrames);
  tagged.set(`cpb-frame-${p.index}`, { layer: group, tag: { id: `cpb-frame-${p.index}` } });
}

// Border or Mask deleted by hand: make it again, on top of the frame (Border)
// or at its bottom (Mask, so the art clips to it again).
async function addMissingShape(frame, r, style, name, id, where) {
  await selectLayer(frame);
  const shape = await makeShape(name, r, style);
  const kids = frame.layers || [];
  if (where === "top" || !kids.length) shape.move(frame, PLACEINSIDE);
  else shape.move(kids[kids.length - 1], PLACEAFTER);
  unclip(shape);
  await setTag(shape, { id });
}

// ---------- main ----------
async function main() {
  const file = await localFileSystem.getFileForOpening({ types: ["svg"] });
  if (!file) return; // cancelled
  const page = readPage(await file.read());
  page.dir = file.nativePath.replace(/\\/g, "/").replace(/\/[^/]*$/, "");
  const message = await core.executeAsModal(async (ctx) => {
    const doc = app.documents.length ? app.activeDocument : null;
    const tagged = doc ? await findTagged(doc) : new Map();
    const frames = tagged.get("cpb-frames");
    if (!frames || Number(frames.tag.page) !== page.number) return buildDocument(page, file.name);
    const problem = sizeProblem(doc, page);
    if (problem) return problem;
    // One history step for the whole update; if anything fails, roll it all back.
    const history = await ctx.hostControl.suspendHistory({ documentID: doc.id, name: "Update comic frames" });
    try {
      const msg = await updateDocument(doc, page, tagged, file.name);
      await ctx.hostControl.resumeHistory(history, true);
      return msg;
    } catch (e) {
      await ctx.hostControl.resumeHistory(history, false);
      throw e;
    }
  }, { commandName: "Import comic page" });
  await app.showAlert(message);
}

// The await matters: Photoshop ends a script as soon as its top-level code
// returns, so without it the import silently stops at the file picker.
await main().catch((e) => app.showAlert("Comic Page Builder import failed:\n" + (e && e.message ? e.message : e)));
